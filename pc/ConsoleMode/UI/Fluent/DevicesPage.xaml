<Page x:Class="ConsoleMode.UI.Fluent.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Móviles">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Móviles" />

            <Border Style="{StaticResource CardRow}" Padding="18">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="8">
                        <Image x:Name="Qr" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Margin="24,4,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Escanea el código con la app Console Mode del móvil." />
                            <ui:SymbolIcon Symbol="Info24" Margin="8,0,0,0" VerticalAlignment="Center"
                                           ToolTip="O búscalo desde la app con «Buscar en la red». La primera vez tendrás que aceptar el móvil en este PC." />
                        </StackPanel>
                        <TextBlock x:Name="Address" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Dispositivos de confianza" />
            <TextBlock x:Name="NoDevices" Style="{StaticResource Secondary}" Text="Ningún móvil vinculado" Margin="2,0,0,0" />
            <StackPanel x:Name="DeviceRows" />
        </StackPanel>
    </ScrollViewer>
</Page>
