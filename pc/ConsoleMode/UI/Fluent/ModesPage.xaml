<Page x:Class="ConsoleMode.UI.Fluent.ModesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ConsoleMode.UI.Fluent"
      Title="Modos">
    <Page.Resources>
        <Style x:Key="DeviceCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="320" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Modos" />

            <Border Style="{StaticResource SegmentedContainer}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PcTab" GroupName="ModeTab" Style="{StaticResource SegmentedRadioButton}" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Modo PC" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ConsoleTab" GroupName="ModeTab" Style="{StaticResource SegmentedRadioButton}" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Modo consola" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardRow}">
                <DockPanel>
                    <local:IconChip DockPanel.Dock="Left" Glyph="&#xE7F4;" ChipColor="#14B8A6" />
                    <ComboBox x:Name="DisplayCombo" DockPanel.Dock="Right" Style="{StaticResource DeviceCombo}" />
                    <TextBlock Style="{StaticResource RowTitle}" Text="Pantalla principal" Margin="16,0" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardRow}">
                <DockPanel>
                    <local:IconChip DockPanel.Dock="Left" Glyph="&#xE767;" ChipColor="#3B82F6" />
                    <ComboBox x:Name="AudioCombo" DockPanel.Dock="Right" Style="{StaticResource DeviceCombo}" />
                    <TextBlock Style="{StaticResource RowTitle}" Text="Salida de audio" Margin="16,0" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardRow}">
                <DockPanel>
                    <local:IconChip DockPanel.Dock="Left" Glyph="&#xE720;" ChipColor="#EC4899" />
                    <ComboBox x:Name="MicCombo" DockPanel.Dock="Right" Style="{StaticResource DeviceCombo}" />
                    <TextBlock Style="{StaticResource RowTitle}" Text="Micrófono" Margin="16,0" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardRow}">
                <DockPanel>
                    <local:IconChip DockPanel.Dock="Left" Glyph="&#xE95B;" ChipColor="#8B5CF6" />
                    <ComboBox x:Name="CommsCombo" DockPanel.Dock="Right" Style="{StaticResource DeviceCombo}" />
                    <TextBlock Style="{StaticResource RowTitle}" Text="Comunicaciones" Margin="16,0"
                               ToolTip="Salida que usan Discord, Teams o Zoom: así puedes oír el juego en la TV y el chat en los auriculares." />
                </DockPanel>
            </Border>

            <ui:Button Content="Actualizar dispositivos" Margin="0,12,0,0" Click="OnRefreshClick">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </ScrollViewer>
</Page>
